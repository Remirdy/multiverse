# NVIDIA Build API Key (NVIDIA NIM)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional Local OpenAI-Compatible Inference Endpoints
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
MLX_BASE_URL=http://127.0.0.1:8081/v1

# Execution Policies & Limits
DEFAULT_TIMEOUT_SECONDS=90.0
MAX_CONCURRENT_MODELS=6
DEFAULT_MAX_CALLS_PER_RUN=24
LOCAL_ONLY_DEFAULT=false
FREE_ONLY_DEFAULT=true

# SQLite Database
DATABASE_URL=sqlite+aiosqlite:///./multiverse.db
